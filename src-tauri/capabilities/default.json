{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "store:default",
    "allow-is-available",
    "allow-authorize-seed",
    "allow-get-authorized-seeds",
    "allow-get-accounts",
    "allow-sign-transaction"
  ]
}
